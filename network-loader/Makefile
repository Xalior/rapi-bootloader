#
# rapi-bootloader network-loader — the dev chainloader.
#
# Adapted from circle/sample/38-bootloader. Static IP 192.168.42.99
# (no DHCP on this segment), staging buffer in the high heap so MAME-sized
# images can't overlap their copy destination. Serves TFTP + HTTP (port
# 8080) + WebDAV (port 8081). Push a new kernel by TFTP-writing it to the
# loader's IP with any TFTP client.
#
# Links a LOCAL single-core circle-stdlib world (rapi-bootloader owns
# its own checkouts, each configured WITHOUT ARM_ALLOW_MULTI_CORE): the
# boot world is single-core by design because Circle's EnableChainBoot()
# refuses ARM_ALLOW_MULTI_CORE builds. CIRCLEHOME and the C/C++ runtime
# library set come from <world>/Config.mk (generated by its configure).
# The backstop below stops the build loudly if a multicore define ever
# reaches these flags.
#
# RASPPI is baked into a circle-stdlib checkout at configure time, so one
# board = one world = one differently-named output image (Circle's own
# convention): circle-stdlib-rpi3 -> kernel8.img, circle-stdlib-rpi4 ->
# kernel8-rpi4.img, circle-stdlib-rpi5 -> kernel_2712.img. Default is the
# proven Pi 4 world; override to build against another:
#   make -C network-loader CIRCLE_STDLIB=circle-stdlib-rpi3
#

# SRCDIR: where this loader's sources live, relative to the build CWD. A
# plain in-place build has them in the CWD (the default, '.'). The
# top-level concurrent build runs each board in its own build/<board>/
# tree and passes SRCDIR=../.. , so objects and the image land in that
# per-board tree while the sources are found back here -- three boards
# then build in parallel with zero shared-object collision. (Config.mk
# carries ABSOLUTE toolchain/CIRCLEHOME paths, so a build from a subdir
# resolves everything; only the ROOT-relative includes below need SRCDIR.)
SRCDIR ?= .
ROOT   ?= $(SRCDIR)/..
CIRCLE_STDLIB ?= circle-stdlib-rpi4

# Resolve sources when building out-of-tree (a no-op for an in-place build).
vpath %.cpp  $(SRCDIR)
vpath %.html $(SRCDIR)
vpath %.css  $(SRCDIR)
vpath %.ico  $(SRCDIR)

# Sets CIRCLEHOME (= $(CIRCLE_STDLIB)/libs/circle), CIRCLE_STDLIB_LIBS (the
# newlib + libc++ + Circle library set) and CIRCLE_STDLIB_INCLUDES.
include $(ROOT)/$(CIRCLE_STDLIB)/Config.mk

# The two shared parts every loader rides on — the 0x800 defaults-block ABI
# and the chain-boot — with their include paths and build rules.
include $(ROOT)/mk/commons.mk

OBJS = main.o kernel.o httpbootserver.o tftpbootserver.o webdavserver.o eeeprobe.o netconfig.o $(COMMON_OBJS)

# On circle-stdlib the loader links the full newlib + libc++ + Circle
# library set (CIRCLE_STDLIB_LIBS from Config.mk). The Circle archives it
# needs (libsdcard, libfatfs, libfs, libnet, libsched, libcircle) live
# under circle-stdlib/libs/circle and are part of that set; unreferenced
# members are dropped at link time.
LIBS = $(CIRCLE_STDLIB_LIBS)

CONTENT = index.h style.h favicon.h
EXTRACLEAN = $(CONTENT)

include $(CIRCLEHOME)/Rules.mk

# Backstop: chain-boot is single-core by design. If the multicore define
# ever reaches this kernel's flags, stop the build loudly.
ifneq ($(findstring ARM_ALLOW_MULTI_CORE,$(DEFINE)),)
$(error network-loader is single-core by design, but ARM_ALLOW_MULTI_CORE is in DEFINE — reconfigure circle-stdlib WITHOUT -o ARM_ALLOW_MULTI_CORE)
endif

# newlib / libc++ headers resolve through the stdlib include path. -I. picks
# up build-local generated headers (index.h &c.); -I$(SRCDIR) the loader's own
# headers when building out-of-tree (both are '.' for an in-place build).
INCLUDE := -I. -I$(SRCDIR) $(CIRCLE_STDLIB_INCLUDES) $(INCLUDE)

%.h: %.html
	@echo "  GEN   $@"
	@$(CIRCLEHOME)/tools/converttool $< > $@

%.h: %.css
	@echo "  GEN   $@"
	@$(CIRCLEHOME)/tools/converttool $< > $@

%.h: %.ico
	@echo "  GEN   $@"
	@$(CIRCLEHOME)/tools/converttool -b $< > $@

httpbootserver.o: $(CONTENT)

-include $(DEPS)

# pi-mame link rule: TLS-adjacent linker script (binutils 2.44+ refuses a
# PT_TLS segment built from non-adjacent .tdata/.tbss, which libc++/libunwind
# carry). Circle's tree stays pristine.
include $(ROOT)/mk/ld/circle-app.mk
