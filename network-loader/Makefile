#
# rapi-bootloader network-loader — the dev chainloader.
#
# Adapted from circle/sample/38-bootloader. Static IP 192.168.42.99
# (no DHCP on this segment), staging buffer in the high heap so MAME-sized
# images can't overlap their copy destination. Serves TFTP + HTTP (port
# 8080) + WebDAV (port 8081). Push a new kernel by TFTP-writing it to the
# loader's IP with any TFTP client.
#
# Links the LOCAL single-core circle-stdlib world (rapi-bootloader owns
# its own checkout, configured WITHOUT ARM_ALLOW_MULTI_CORE): the boot
# world is single-core by design because Circle's EnableChainBoot()
# refuses ARM_ALLOW_MULTI_CORE builds. CIRCLEHOME and the C/C++ runtime
# library set come from circle-stdlib/Config.mk (generated by its
# configure). The backstop below stops the build loudly if a multicore
# define ever reaches these flags.
#

ROOT = ..

# Sets CIRCLEHOME (= circle-stdlib/libs/circle), CIRCLE_STDLIB_LIBS (the
# newlib + libc++ + Circle library set) and CIRCLE_STDLIB_INCLUDES.
include $(ROOT)/circle-stdlib/Config.mk

# The 0x800 defaults-block writer (PatchDefaults) is the shared ABI, now
# owned by rapi-bootloader/defaultsblock and compiled verbatim here — one
# source of truth. Explicit rules (below) build it into a local object;
# EXTRAINCLUDE resolves its header for defaultsblock.o and tftpbootserver.o.
DEFAULTSDIR = $(ROOT)/defaultsblock
EXTRAINCLUDE = -I$(DEFAULTSDIR)

OBJS = main.o kernel.o httpbootserver.o tftpbootserver.o webdavserver.o eeeprobe.o defaultsblock.o

# On circle-stdlib the loader links the full newlib + libc++ + Circle
# library set (CIRCLE_STDLIB_LIBS from Config.mk). The Circle archives it
# needs (libsdcard, libfatfs, libfs, libnet, libsched, libcircle) live
# under circle-stdlib/libs/circle and are part of that set; unreferenced
# members are dropped at link time.
LIBS = $(CIRCLE_STDLIB_LIBS)

CONTENT = index.h style.h favicon.h
EXTRACLEAN = $(CONTENT)

include $(CIRCLEHOME)/Rules.mk

# Backstop: chain-boot is single-core by design. If the multicore define
# ever reaches this kernel's flags, stop the build loudly.
ifneq ($(findstring ARM_ALLOW_MULTI_CORE,$(DEFINE)),)
$(error network-loader is single-core by design, but ARM_ALLOW_MULTI_CORE is in DEFINE — reconfigure circle-stdlib WITHOUT -o ARM_ALLOW_MULTI_CORE)
endif

# newlib / libc++ headers resolve through the stdlib include path.
INCLUDE := $(CIRCLE_STDLIB_INCLUDES) $(INCLUDE)

%.h: %.html
	@echo "  GEN   $@"
	@$(CIRCLEHOME)/tools/converttool $< > $@

%.h: %.css
	@echo "  GEN   $@"
	@$(CIRCLEHOME)/tools/converttool $< > $@

%.h: %.ico
	@echo "  GEN   $@"
	@$(CIRCLEHOME)/tools/converttool -b $< > $@

httpbootserver.o: $(CONTENT)

# The shared 0x800 writer lives in rapi-bootloader/defaultsblock; compile it
# into a local object here (Circle's %.o rule only matches same-directory
# sources). The matching .d keeps a defaultsblock.h edit rebuilding it.
defaultsblock.o: $(DEFAULTSDIR)/defaultsblock.cpp
	@echo "  CPP   $@"
	@$(CPP) $(CPPFLAGS) -c -o $@ $<

defaultsblock.d: $(DEFAULTSDIR)/defaultsblock.cpp
	@$(CPP) $(CPPFLAGS) -M -MG -MT defaultsblock.o -MT $@ -MF $@ $<

-include $(DEPS)

# pi-mame link rule: TLS-adjacent linker script (binutils 2.44+ refuses a
# PT_TLS segment built from non-adjacent .tdata/.tbss, which libc++/libunwind
# carry). Circle's tree stays pristine.
include $(ROOT)/mk/ld/circle-app.mk
