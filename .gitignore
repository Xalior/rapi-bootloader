# Build outputs — the committed tree is source only.
*.o
*.d
*.elf
*.img
*.lst
*.map

# converttool-generated headers (network-loader web content).
network-loader/index.h
network-loader/style.h
network-loader/favicon.h

# Each circle-stdlib-rpi{3,4,5} world's build tree + its LLVM checkout
# (large; fetched/built by the top-level `deps` target or its per-board
# equivalent — see README.md).
circle-stdlib-rpi3/build/
circle-stdlib-rpi3/install*/
circle-stdlib-rpi3/Config.mk
circle-stdlib-rpi3/libs/llvm-project/
circle-stdlib-rpi4/build/
circle-stdlib-rpi4/install*/
circle-stdlib-rpi4/Config.mk
circle-stdlib-rpi4/libs/llvm-project/
circle-stdlib-rpi5/build/
circle-stdlib-rpi5/install*/
circle-stdlib-rpi5/Config.mk
circle-stdlib-rpi5/libs/llvm-project/

# Per-board loader build trees. The concurrent out-of-tree builds
# (`make <loader>-<board>`) put objects, converttool-generated headers and
# the image in <loader>/build/<board>/ — all outputs, nothing source.
network-loader/build/
menu-loader/build/

# Assembled SD-card contents: dist/ collects the per-board loader images
# (`make dist`), plus the multi-board network-loader trial and any future
# assemblies — not source.
dist/
