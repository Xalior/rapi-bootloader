#
# rapi-bootloader menu-loader — the on-card boot picker.
#
# A boot-world Circle app: it prints the bootmenu.cfg list, takes a
# keyboard pick, patches the chosen defaults-string into a staged platform
# kernel image at offset 0x800, and chain-boots it.
#
# Links the LOCAL single-core circle-stdlib world (rapi-bootloader owns its
# own checkout, configured WITHOUT ARM_ALLOW_MULTI_CORE): the boot world is
# single-core by design because Circle's EnableChainBoot() refuses
# ARM_ALLOW_MULTI_CORE builds. CIRCLEHOME and the C/C++ runtime library set
# come from circle-stdlib/Config.mk (generated by its configure). The
# backstop below stops the build loudly if a multicore define ever reaches
# these flags.
#

# SRCDIR: where this loader's sources live, relative to the build CWD (see
# network-loader/Makefile for the full rationale). '.' for an in-place build;
# the top-level concurrent build passes SRCDIR=../.. to compile each board in
# its own build/<board>/ tree, so all boards build in parallel without
# sharing objects. Config.mk carries absolute paths, so a subdir build resolves.
SRCDIR ?= .
ROOT   ?= $(SRCDIR)/..

# Resolve sources when building out-of-tree (a no-op for an in-place build).
vpath %.cpp $(SRCDIR)

# One board = one single-core circle-stdlib world (RASPPI baked at configure
# time): circle-stdlib-rpi3 -> kernel8.img, circle-stdlib-rpi4 ->
# kernel8-rpi4.img, circle-stdlib-rpi5 -> kernel_2712.img. Default is the
# proven Pi 4 world; the top-level Makefile overrides it per board:
#   make -C menu-loader CIRCLE_STDLIB=circle-stdlib-rpi3
CIRCLE_STDLIB ?= circle-stdlib-rpi4

# Sets CIRCLEHOME (= $(CIRCLE_STDLIB)/libs/circle), CIRCLE_STDLIB_LIBS (the
# newlib + libc++ + Circle library set) and CIRCLE_STDLIB_INCLUDES.
include $(ROOT)/$(CIRCLE_STDLIB)/Config.mk

# The 0x800 defaults-block writer (PatchDefaults) is the shared ABI, now
# owned by rapi-bootloader/defaultsblock and compiled verbatim here — one
# source of truth. Explicit rules (below) build it into a local object;
# EXTRAINCLUDE resolves its header for defaultsblock.o and kernel.o.
DEFAULTSDIR = $(ROOT)/defaultsblock
EXTRAINCLUDE = -I$(DEFAULTSDIR)

OBJS = main.o kernel.o bootmenu.o defaultsblock.o

# On circle-stdlib the loader links the full newlib + libc++ + Circle
# library set (CIRCLE_STDLIB_LIBS from Config.mk). The Circle archives it
# needs (libusb, libinput, libsdcard, libfatfs, libfs, libsched, libcircle)
# live under circle-stdlib/libs/circle and are part of that set; unreferenced
# members are dropped at link time.
LIBS = $(CIRCLE_STDLIB_LIBS)

include $(CIRCLEHOME)/Rules.mk

# Backstop: chain-boot is single-core by design. If the multicore define
# ever reaches this kernel's flags, stop the build loudly.
ifneq ($(findstring ARM_ALLOW_MULTI_CORE,$(DEFINE)),)
$(error menu-loader is single-core by design, but ARM_ALLOW_MULTI_CORE is in DEFINE — reconfigure circle-stdlib WITHOUT -o ARM_ALLOW_MULTI_CORE)
endif

# newlib / libc++ headers resolve through the stdlib include path. -I. picks
# up build-local generated headers; -I$(SRCDIR) the loader's own headers when
# building out-of-tree (both are '.' for an in-place build).
INCLUDE := -I. -I$(SRCDIR) $(CIRCLE_STDLIB_INCLUDES) $(INCLUDE)

# The shared 0x800 writer lives in rapi-bootloader/defaultsblock; compile it
# into a local object here (Circle's %.o rule only matches same-directory
# sources). The matching .d keeps a defaultsblock.h edit rebuilding it.
defaultsblock.o: $(DEFAULTSDIR)/defaultsblock.cpp
	@echo "  CPP   $@"
	@$(CPP) $(CPPFLAGS) -c -o $@ $<

defaultsblock.d: $(DEFAULTSDIR)/defaultsblock.cpp
	@$(CPP) $(CPPFLAGS) -M -MG -MT defaultsblock.o -MT $@ -MF $@ $<

-include $(DEPS)

# Boot-world link rule: TLS-adjacent linker script (binutils 2.44+ refuses a
# PT_TLS segment built from non-adjacent .tdata/.tbss, which libc++/libunwind
# carry). Circle's tree stays pristine.
include $(ROOT)/mk/ld/circle-app.mk
